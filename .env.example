# GitHub repo root - local environment template
# Copy this file to .env and fill in real values.

# Core
PORT=4000
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=strongpassword

# Local model / proxy
LOCAL_LLM_BASE_URL=http://host.docker.internal:7860
MODEL_PROXY_URL=http://localhost:4010

# Cloud fallback (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_API_KEY=

# Google / YouTube / Publish integrations (optional in Phase 1)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Storage
ARTIFACTS_DIR=./artifacts

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Schedule windows (24h format)
PRODUCTION_START_HOUR=09
PRODUCTION_END_HOUR=12
NIGHT_START_HOUR=23
NIGHT_END_HOUR=07
